# MySQL: crie o banco odontologia antes de iniciar a aplicacao.
DATABASE_URL=mysql+pymysql://USUARIO:SENHA@HOST:3306/odontologia

# Gere uma chave aleatoria para sessoes Flask.
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
FLASK_DEBUG=0
SESSION_COOKIE_SECURE=1
PORT=8000

# Acesso ao painel da doutora.
DOCTOR_USERNAME=emille
DOCTOR_PASSWORD=troque-por-uma-senha-forte

# Credenciais da Meta WhatsApp Cloud API.
WHATSAPP_ENABLED=0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_VERIFY_TOKEN=crie-um-token-de-verificacao
WHATSAPP_APP_SECRET=
